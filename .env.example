# ═══════════════════════════════════════════════════
# Ajanta Electronics Task Manager — Environment Variables
# ═══════════════════════════════════════════════════
# Is file ko `.env` ke naam se rename karo aur values bharo

# ── Database ──────────────────────────────────────────
# If DB_HOST is set, the app uses real MySQL (mysql-db.js) — this is
# the primary path now. Leave DB_HOST blank to fall back to the
# Google Sheets backed adapter (sheets-db.js) instead.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Run `node migrate-to-mysql.js` once (after creating the schema with
# schema.sql) to copy existing data out of the Sheets DB into MySQL.

# ── Google Sheets (only used when DB_HOST above is blank) ────────────
# 1. Google Sheets me ek BLANK spreadsheet banao
# 2. Use service account ke saath share karo (Editor access):
#    akhileshvyas@reactwebappav.iam.gserviceaccount.com
# 3. Sheet ke URL se ID copy karo (.../spreadsheets/d/<ID>/edit)
#    ya poora URL bhi paste kar sakte ho — script ID extract kar lega
GOOGLE_SHEET_ID=PASTE_YOUR_GOOGLE_SHEET_ID_HERE

# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
SESSION_SECRET=change_this_to_a_random_long_string

# ── Email Automation (Gmail SMTP) — OPTIONAL ─────────
# 1. Gmail account me 2-Step Verification ON karo
# 2. https://myaccount.google.com/apppasswords se App Password banao
# 3. 16-character password (without spaces) yahan paste karo
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Ajanta Electronics Task Manager

# Aapke deployed app ka URL (email me link button ke liye)
APP_URL=http://localhost:3000

# ── Maytapi WhatsApp API (Service FMS OTP) — OPTIONAL ─
# maytapi.com dashboard se Product ID, Phone ID aur Token milega
MAYTAPI_PRODUCT_ID=
MAYTAPI_PHONE_ID=
MAYTAPI_TOKEN=
