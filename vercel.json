{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**",
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/attendance-alert?slot=morning", "schedule": "30 5 * * *" },
    { "path": "/api/cron/attendance-alert?slot=evening", "schedule": "30 14 * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
